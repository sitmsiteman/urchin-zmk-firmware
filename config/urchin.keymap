#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include "keymap_italian.h"

// Layer definitions

#define BASE 0
#define SYM 1
#define EXT 2
#define FNC 3
#define SYM2 4
#define ACCENT 5
#define SETTINGS 6

// -----------------

&mt {
    tapping-term-ms = <185>;
    quick-tap-ms = <100>;
    flavor = "tap-preferred";
};

/ {
    behaviors {
        // Enables holding the first mod-tap key
        // by performing a tap-release-hold sequence.
        // To use it: "&qt KEYCODE1 KEYCODE2"

        qt: quick_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "QUICK_TAP";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <185>;
            quick-tap-ms = <100>;
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        // sometimes my device thinks a modifier is being held down
        // pressing all modifiers fixes it.
    };

    combos {
        compatible = "zmk,combos";

        // both right thumb keys
        // internal-left & external-right thumb keys
        // both left thumb keys

        combo_settings {
            timeout-ms = <200>;
            key-positions = <30 31>;
            bindings = <&mo 5>;
        };

        // left index & middle fingers (home-row)
        // hold control & space for Adobe workflow

        rctrl_combo {
            bindings = <&kp RCTRL>;
            key-positions = <28 29>;
            layers = <0>;
        };

        ralt_combo {
            bindings = <&kp RALT>;
            key-positions = <8 9>;
            layers = <0>;
        };

        esc_combo {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
            layers = <0>;
        };

        del_combo {
            bindings = <&kp DEL>;
            key-positions = <26 27>;
            layers = <0>;
        };

        quote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <18 19>;
            layers = <0>;
        };

        grave {
            bindings = <&kp GRAVE>;
            key-positions = <10 11>;
            layers = <0>;
        };

        capsword {
            bindings = <&caps_word>;
            key-positions = <13 16>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Base alpha layer

        default_layer {
            label = "Base";
            bindings = <
&kp Q       &kp W       &kp E        &kp R         &kp T        &kp Y        &kp U            &kp I        &kp O           &kp P
&mt LGUI A  &mt LALT S  &mt LCTRL D  &mt LSHIFT F  &kp G        &kp H        &mt RSHIFT J     &mt LCTRL K  &mt LEFT_ALT L  &mt RGUI SEMICOLON
&kp Z       &kp X       &kp C        &kp V         &kp B        &kp N        &kp M            &kp COMMA    &kp DOT         &kp SLASH
                                     &lt 4 TAB     &lt 1 SPACE  &lt 3 ENTER  &lt 2 BACKSPACE
            >;
        };

        // Numbers and high frequency symbols

        etc_layer {
            label = "etc.";
            bindings = <
&kp K_MUTE  &kp C_VOLUME_UP  &kp C_VOLUME_DOWN  &trans  &trans           &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &trans
&trans      &trans           &trans             &trans  &kp PRINTSCREEN  &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &trans
&trans      &trans           &trans             &trans  &trans           &trans    &trans     &trans     &trans     &trans
                                                &trans  &trans           &trans    &trans
            >;
        };

        // Main modifiers and arrow keys

        sym_layer {
            label = "sym";
            bindings = <
&kp LS(NUMBER_6)  &kp LS(NUMBER_4)   &kp LS(NUMBER_5)  &kp LS(NUMBER_8)  &kp LS(NUMBER_7)  &trans  &kp LS(LEFT_BRACKET)  &kp LS(RIGHT_BRACKET)  &trans         &trans
&kp LS(NUMBER_1)  &kp MINUS          &kp LS(EQUAL)     &kp EQUAL         &kp LS(MINUS)     &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LS(COMMA)  &kp LS(PERIOD)
&kp BACKSLASH     &kp LS(BACKSLASH)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(GRAVE)     &trans  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans         &trans
                                                       &trans            &trans            &trans  &trans
            >;
        };

        // Function keys with modifiers

        num_layer {
            label = "num";
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0
&trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans
&trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans
                                          &trans        &trans        &trans        &trans
            >;
        };

        // Low frequency symbols.

        fn_layer {
            label = "fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9   &kp F10
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
                        &trans  &trans  &trans  &trans
            >;
        };

        // Used to type regional accents.
        // Used to change the keyboard's settings.

        settings_layer {
            label = "Sett.";
            bindings = <
&bootloader     &none  &none  &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 3  &none  &unstick  &none  &bootloader
&none           &none  &none  &none       &bt BT_SEL 1  &bt BT_SEL 4  &none  &none     &none  &none
&studio_unlock  &none  &none  &none       &bt BT_SEL 2  &bt BT_SEL 5  &none  &none     &none  &studio_unlock
                              &none       &none         &none         &none
            >;
        };
    };
};
